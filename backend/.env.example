# Copy this file to .env and fill your real API keys locally.
# Never commit your real .env file to GitHub.

# Brain / Cognitive Gateway
OPENAI_API_KEY=your_openai_api_key_here
JACOB_OPENAI_MODEL=gpt-4.1-mini

# OpenAI TTS fallback
JACOB_TTS_MODEL=gpt-4o-mini-tts
JACOB_TTS_VOICE=onyx

# ElevenLabs Premium Voice
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Replace this with the Voice ID of the ElevenLabs voice named "Will" from your account.
# ElevenLabs API uses voice_id, not the visible voice name.
ELEVENLABS_VOICE_ID=voice_id_da_voz_will_aqui
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
